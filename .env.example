# 복사해서 .env 로 저장하세요. .env 는 커밋하지 않습니다.
PORT=3000
# 서버 배포(docker compose --profile app)에서 바깥에 여는 포트. 로컬은 3200
APP_PORT=3200
DATABASE_URL=postgres://neuri:neuri@localhost:5433/neuri
# 시연 초기화(/api/demo/reset, npm run smoke) 비밀 값. 배포 서버에는 꼭 긴 무작위 값을 넣으세요.
# 비워 두면 서버 컴퓨터 자신(localhost)에서만 초기화할 수 있습니다.
RESET_TOKEN=

# 시연용: 지난 시간대·영업시간·"도착했어" 거리를 따지지 않습니다.
DEMO_MODE=true
# 위치 동의를 안 했을 때의 기본 동네 (영남대 경산캠퍼스)
DEMO_CENTER_LAT=35.8318613
DEMO_CENTER_LNG=128.7585416

# LLM (OpenAI 호환 API). 세 값만 바꾸면 공급자를 갈아탈 수 있습니다.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai  /  gemini-3.1-flash-lite (2026-11 기준, 약 1.8초)
#   모델은 예고 없이 종료되기도 함. 404 "no longer available"이면 GET {LLM_BASE_URL}/models 로 지금 쓸 수 있는 이름 확인
# Groq:   https://api.groq.com/openai/v1                            /  llama-3.3-70b-versatile
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=

# 카카오 로컬 REST API 키 (developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키)
# 무료 장소(카페·도서관·공원) 검색과 주소 → 좌표에 씀. 비워 두면 두 기능만 꺼짐
KAKAO_REST_API_KEY=
# 제휴 매장 실제 사진 (Google Places API (New)). 비우면 그림으로 보임
GOOGLE_PLACES_KEY=

# 예비 공급자 (비워 두면 사용 안 함). 주 공급자가 429·타임아웃·오류일 때 넘어갑니다.
# 네이버클라우드 CLOVA Studio (하이퍼클로바X). 테스트 앱의 API 키로 충분합니다.
# HCX-007은 JSON 지시를 잘 안 지켜서 형식 강제(STRUCTURED)와 추론 끄기(EXTRA)를 꼭 함께 켭니다.
# (HCX-005, HCX-DASH-002는 형식 강제를 지원하지 않아 마음 확인·속마음이 거의 다 실패함 — 2026-11-18 검증)
LLM_FALLBACK_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
LLM_FALLBACK_MODEL=HCX-007
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_STRUCTURED=true
LLM_FALLBACK_EXTRA={"reasoning_effort":"none"}
